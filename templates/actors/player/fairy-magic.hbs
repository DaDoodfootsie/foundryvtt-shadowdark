<section class="tab tab-fairy-magic" data-group="primary" data-tab="tab-fairy-magic">

	{{!-- GLAMOURS --}}
	{{#> ui/sd-hideable-section
		sectionId=""
		sectionTitle=(concat (localize "DOLMENDARK.fairy.glamours") " (" glamoursKnown " / " actor.system.fairyMagic.glamoursMax ")")
	}}
		{{#if glamours.length}}
			<ol class="SD-list">
				<li class="header">
					<div class="item-name">{{localize "DOLMENDARK.fairy.glamour"}}</div>
					<div class="duration">{{localize "DOLMENDARK.item.duration"}}</div>
					<div class="range">{{localize "DOLMENDARK.item.range"}}</div>
					<div class="actions"></div>
				</li>
				{{#each glamours}}
					<li class="item" data-item-id="{{_id}}">
						<div class="item-image" style="background-image: url({{img}})">
							<i class="fas fa-comment fa-lg"></i>
						</div>
						<a class="item-name {{#unless system.isAvailable}}strike-through{{/unless}}" data-action="show-details">
							{{name}}
						</a>
						<div class="duration">{{system.duration}}</div>
						<div class="range">{{system.range}}</div>
						<div class="actions">
							<a
								data-action="cast-glamour"
								data-item-id="{{_id}}"
								data-tooltip="{{localize 'DOLMENDARK.fairy.use_glamour'}}"
								class="{{#unless system.isAvailable}}disabled{{/unless}}"
							>
								<i class="fa-solid fa-hand-sparkles"></i>
							</a>
						</div>
					</li>
				{{/each}}
			</ol>
		{{else}}
			<p class="fairy-empty">{{localize "DOLMENDARK.fairy.no_glamours"}}</p>
		{{/if}}
	{{/ui/sd-hideable-section}}

	{{!-- LESSER RUNES --}}
