						<div class="actions">
							<a data-action="use-rune" data-item-id="{{_id}}" data-tooltip="{{localize 'DOLMENDARK.fairy.use_rune'}}" class="{{#if (gte usage.used usage.max)}}disabled{{/if}}">
								<i class="fa-solid fa-hand-sparkles"></i>
							</a>
						</div>
					</li>
				{{/each}}
			</ol>
		{{else}}
